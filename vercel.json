{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "cd frontend && npm install",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://toyota-gr.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://toyota-gr.onrender.com/api/:path*"
    }
  ]
}

